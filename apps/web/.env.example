# =============================================================================
#  AetherOS.ai — apps/web (Next.js 15 Frontend)
# =============================================================================
#
#  Copy this file to `.env.local` in this directory, fill in your values.
#
#  NAMESPACE RULES
#  NEXT_PUBLIC_* = inlined at BUILD TIME, visible in browser (rebuild required!)
#  No prefix     = server-side only, never exposed to browser
#
#  [REQUIRED]  = App won't work without this
#  [OPTIONAL]  = Has a safe default
# =============================================================================


# =============================================================================
#  Backend API Connection (1 variable)
# =============================================================================
#  Base URL of the FastAPI backend. Used by:
#  - Next.js rewrites: /api/* is proxied to this URL (next.config.ts)
#  - Client pages: dashboard, inbox, calendar, command, replies, settings
#
#  Default: http://localhost:8000
#  [OPTIONAL]
NEXT_PUBLIC_API_URL=http://localhost:8000


# =============================================================================
#  Clerk Authentication (4 variables)
# =============================================================================
#  Setup: https://dashboard.clerk.com
#
#  CLERK_SECRET_KEY is server-side only (no NEXT_PUBLIC_ prefix).
#  All others are NEXT_PUBLIC_ and exposed to the browser.

# Clerk Publishable Key (starts with pk_test_ or pk_live_)
# [REQUIRED]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Redirect destination after sign-in (relative or absolute URL)
# [OPTIONAL]  Default: /dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# Redirect destination after sign-up (relative or absolute URL)
# [OPTIONAL]  Default: /dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk Secret Key (starts with sk_test_ or sk_live_)
# Server-side only — used by middleware (proxy.ts) for session verification
# [REQUIRED]
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
