# =============================================================================
#  AetherOS.ai — apps/extension (Chrome Extension — Vite + React)
# =============================================================================
#
#  Copy this file to `.env` in this directory, fill in your values.
#
#  All extension env vars must use the VITE_ prefix (Vite convention).
#  They are inlined at BUILD TIME — rebuilding the extension is required
#  after changing any value.
#
#  [REQUIRED]  = Extension won't work without this
#  [OPTIONAL]  = Has a safe default
# =============================================================================


# =============================================================================
#  Backend API Connection (2 variables)
# =============================================================================

# VITE_API_URL
#   Base URL of the FastAPI backend. Used by:
#   - All API calls from the extension (api-client.ts)
#   - Background service worker badge polling (service-worker.ts)
#
#   Format: http://<host>:<port>
#   Default: http://localhost:8000
#   [OPTIONAL]
VITE_API_URL=http://localhost:8000

# VITE_WS_URL
#   WebSocket URL for real-time event streaming from the backend.
#   Used by: websocket-client.ts (live dashboard updates, notifications)
#
#   Format: ws://<host>:<port>/ws  or  wss://<host>/ws
#   Default: ws://localhost:8000/ws
#   [OPTIONAL]
VITE_WS_URL=ws://localhost:8000/ws


# =============================================================================
#  Clerk Authentication (1 variable, [REQUIRED])
# =============================================================================

# VITE_CLERK_FRONTEND_API
#   Clerk Frontend API domain (without protocol prefix).
#   Used to construct the OAuth sign-in URL for the extension's
#   chrome.identity.launchWebAuthFlow authentication flow.
#
#   The extension opens: https://<this-value>/sign-in
#
#   Find this in Clerk Dashboard → API Keys → Frontend API URL
#   Typical format: <your-app-name>.clerk.accounts.dev
#
#   IMPORTANT: This is NOT the JWT Issuer URL and NOT the
#   Publishable Key. It is the Clerk Frontend API domain.
#
#   [REQUIRED]
VITE_CLERK_FRONTEND_API=your-app.clerk.accounts.dev
